# Copy to .env and fill in your keys.
# .env is gitignored — never commit it.

# ElevenLabs API key. Get from https://elevenlabs.io/app/settings/api-keys
# Note: Instant Voice Cloning requires Starter ($5/mo) or higher tier.
ELEVENLABS_API_KEY=

# Replicate API token. Get from https://replicate.com/account/api-tokens
# Chatterbox runs at: https://replicate.com/resemble-ai/chatterbox
REPLICATE_API_TOKEN=

# Optional: server bind host/port (defaults shown)
HOST=127.0.0.1
PORT=8000
